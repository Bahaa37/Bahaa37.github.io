@*
    One case study, told as problem → approach → outcome.

    A CV bullet has room to say what was done; this has room to show how it was decided,
    which is the part a hiring manager is actually assessing.
*@

<article class="case stagger" id="@Study.Slug" style="--i: @Index">
    <header class="case__head">
        <p class="eyebrow">
            @(Study.Organisation ?? "Project")
            <span class="case__index">@($"{Index:00}")</span>
        </p>
        <h3 class="case__title">@Study.Title</h3>
        <p class="case__summary">@Study.Summary</p>
    </header>

    <div class="case__grid">
        <div class="case__block">
            <h4>The problem</h4>
            <p>@Study.Problem</p>
        </div>
        <div class="case__block">
            <h4>What I did</h4>
            <p>@Study.Approach</p>
        </div>
    </div>

    @if (Study.Outcomes.Count > 0)
    {
        <div class="case__block case__block--outcomes">
            <h4>Outcome</h4>
            <ul class="outcomes">
                @foreach (var outcome in Study.Outcomes)
                {
                    <li>@outcome</li>
                }
            </ul>
        </div>
    }

    @if (Study.Stack.Count > 0)
    {
        <ul class="stack">
            @foreach (var item in Study.Stack)
            {
                <li class="tag">@item</li>
            }
        </ul>
    }

    @*
        Every case study now has a page of its own, so each card has somewhere to go.
        Where a deeper write-up exists it is offered as well — those are different
        documents, not two links to the same one.
    *@
    <div class="case__diagram">
        <a class="btn btn--primary" href="@($"/work/{Study.Slug}")">Read the case study</a>

        @if (Study.HasWriteup)
        {
            <a class="btn btn--ghost" href="@Study.WriteupUrl">Full technical write-up</a>
        }

        @if (Study.HasDiagram)
        {
            <ArchitectureDiagram Id="@($"panel-{Study.Slug}")" Source="@Study.MermaidDiagram" />
        }
    </div>
</article>

@code {
    [Parameter, EditorRequired]
    public required CaseStudy Study { get; set; }

    [Parameter]
    public int Index { get; set; }
}
