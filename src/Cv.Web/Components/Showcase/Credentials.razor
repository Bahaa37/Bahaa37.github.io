@*
    Awards, education, and the complete certification list.

    The printable CV carries only five certifications because a page of them is a page
    not spent on achievements. Here all of them fit at no cost, which is the whole point
    of having two renderers over one dataset.
*@

<section class="sheet reveal" id="credentials">
    <div class="shell">
        <h2 class="sheet__title">Recognition, education, and certifications</h2>

        @if (Awards.Count > 0)
        {
            <div class="awards">
                @foreach (var award in Awards)
                {
                    <div class="award">
                        <h3 class="award__title">@award.Title</h3>
                        <p class="award__issuer">@award.Issuer</p>
                        @if (!string.IsNullOrWhiteSpace(award.Description))
                        {
                            <p class="award__detail">@award.Description</p>
                        }
                    </div>
                }
            </div>
        }

        <div class="split">
            <div>
                <h3 class="sub">Education</h3>
                <ul class="education">
                    @foreach (var entry in Education.OrderByDescending(e => e.Period.Start))
                    {
                        <li>
                            <p class="education__credential">@entry.Credential</p>
                            <p class="education__meta">
                                @entry.Institution · @entry.Period.ToShortDisplayString()
                                @if (entry.InProgress)
                                {
                                    <span class="badge badge--progress">In progress</span>
                                }
                            </p>
                        </li>
                    }
                </ul>
            </div>

            <div>
                <h3 class="sub">Certifications (@Certifications.Count)</h3>
                @*
                    The five that also appear on the printed CV are the skim; the long
                    tail is one no-JS disclosure away. Seventeen equal-weight entries
                    diluted the senior signal the featured set exists to carry.
                *@
                <ul class="certs">
                    @foreach (var certification in Featured)
                    {
                        <li class="cert cert--featured">
                            <span class="cert__name">@certification.Name</span>
                            <span class="cert__meta">
                                @certification.Issuer@(certification.Awarded is { } a ? $" · {a.ToShortDisplayString()}" : "")
                            </span>
                        </li>
                    }
                </ul>

                @if (Rest.Count > 0)
                {
                    <details class="disclosure">
                        <summary>Show @Rest.Count more certifications</summary>
                        <ul class="certs certs--more">
                            @foreach (var certification in Rest)
                            {
                                <li class="cert">
                                    <span class="cert__name">@certification.Name</span>
                                    <span class="cert__meta">
                                        @certification.Issuer@(certification.Awarded is { } a ? $" · {a.ToShortDisplayString()}" : "")
                                    </span>
                                </li>
                            }
                        </ul>
                    </details>
                }
            </div>
        </div>
    </div>
</section>

@code {
    [Parameter, EditorRequired]
    public required IReadOnlyList<Award> Awards { get; set; }

    [Parameter, EditorRequired]
    public required IReadOnlyList<EducationEntry> Education { get; set; }

    [Parameter, EditorRequired]
    public required IReadOnlyList<Certification> Certifications { get; set; }

    /// <summary>The five that also appear on the printed CV, same ranking as ever.</summary>
    private IReadOnlyList<Certification> Featured => Certifications
        .Where(c => c.IsFeatured)
        .OrderByDescending(c => c.Awarded)
        .ToList();

    /// <summary>The long tail: real, kept, and one disclosure away rather than at equal weight.</summary>
    private IReadOnlyList<Certification> Rest => Certifications
        .Where(c => !c.IsFeatured)
        .OrderByDescending(c => c.Awarded)
        .ToList();
}
