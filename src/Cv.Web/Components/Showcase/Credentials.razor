@*
    Awards, education, and the complete certification list.

    The awards are cards — recognition is the one place the page allows itself a gold
    glow. Education and certifications are ruled grid rows: mono data lines under a
    plain heading, the long certification tail one no-JS disclosure away. The printed
    CV carries only five certifications because a page of them is a page not spent on
    achievements; here all of them fit at no cost, which is the whole point of having
    two renderers over one dataset.
*@

<section class="section" id="credentials">
    <div class="hl-container section__frame">
        <header class="section__head" data-hl-reveal>
            <h2 class="hl-h2">Recognition, education, and certifications</h2>
        </header>

        @if (Awards.Count > 0)
        {
            <div class="awards" data-hl-reveal="list">
                @foreach (var award in Awards)
                {
                    <div class="hl-card award">
                        @* Decorative; the card clips it so the orb can never widen the page. *@
                        <span class="hl-glow hl-glow--gold award__glow" aria-hidden="true"></span>
                        <h3 class="hl-h4 award__title">@award.Title</h3>
                        <p class="award__issuer">@award.Issuer</p>
                        @if (!string.IsNullOrWhiteSpace(award.Description))
                        {
                            <p class="hl-body award__detail">@award.Description</p>
                        }
                    </div>
                }
            </div>
        }

        <div class="hl-grid hl-grid--flush cred-grid" data-hl-reveal="list">
            <div class="hl-cell cred">
                <h3 class="hl-h4 cred__heading">Education</h3>
                <ul class="cred__list">
                    @foreach (var entry in Education.OrderByDescending(e => e.Period.Start))
                    {
                        <li class="cred__row">
                            <p class="cred__name">@entry.Credential</p>
                            <p class="cred__meta">
                                @entry.Institution · @entry.Period.ToShortDisplayString()
                                @if (entry.InProgress)
                                {
                                    <span class="badge badge--progress">In progress</span>
                                }
                            </p>
                        </li>
                    }
                </ul>
            </div>

            <div class="hl-cell cred">
                <h3 class="hl-h4 cred__heading">Certifications (@Certifications.Count)</h3>
                @*
                    The five that also appear on the printed CV are the skim; the long
                    tail is one no-JS disclosure away. Seventeen equal-weight entries
                    diluted the senior signal the featured set exists to carry.
                *@
                <ul class="cred__list">
                    @foreach (var certification in Featured)
                    {
                        <li class="cred__row">
                            <p class="cred__name cred__name--strong">@certification.Name</p>
                            <p class="cred__meta">
                                @certification.Issuer@(certification.Awarded is { } a ? $" · {a.ToShortDisplayString()}" : "")
                            </p>
                        </li>
                    }
                </ul>

                @if (Rest.Count > 0)
                {
                    <details class="disclosure">
                        <summary class="hl-btn hl-btn--ghost hl-btn--sm">Show @Rest.Count more certifications</summary>
                        <ul class="cred__list cred__list--more">
                            @foreach (var certification in Rest)
                            {
                                <li class="cred__row">
                                    <p class="cred__name">@certification.Name</p>
                                    <p class="cred__meta">
                                        @certification.Issuer@(certification.Awarded is { } a ? $" · {a.ToShortDisplayString()}" : "")
                                    </p>
                                </li>
                            }
                        </ul>
                    </details>
                }
            </div>
        </div>
    </div>
</section>

@code {
    [Parameter, EditorRequired]
    public required IReadOnlyList<Award> Awards { get; set; }

    [Parameter, EditorRequired]
    public required IReadOnlyList<EducationEntry> Education { get; set; }

    [Parameter, EditorRequired]
    public required IReadOnlyList<Certification> Certifications { get; set; }

    /// <summary>The five that also appear on the printed CV, same ranking as ever.</summary>
    private IReadOnlyList<Certification> Featured => Certifications
        .Where(c => c.IsFeatured)
        .OrderByDescending(c => c.Awarded)
        .ToList();

    /// <summary>The long tail: real, kept, and one disclosure away rather than at equal weight.</summary>
    private IReadOnlyList<Certification> Rest => Certifications
        .Where(c => !c.IsFeatured)
        .OrderByDescending(c => c.Awarded)
        .ToList();
}
