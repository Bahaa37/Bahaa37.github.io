@*
    Opening screen — the Sky Aluminum first viewport.

    The hero is one solid sheet on the flat sky ground, and it carries the
    before/after architecture itself, so an architect reader sees the kind of problem
    being solved before reading a word of prose. The verified metrics live in a single
    mono facts line rather than a stat-card band: they skim in one fixation and no card
    grid is spent on them. The award figure keeps the page's only gold.
*@

<section class="sheet hero" aria-label="Introduction">
    <div class="hero__grid">

        <div class="hero__lede">
            @*
                Each line is its own clipping box so the headline can rise line by
                line rather than fading in as one block. The break points are set
                here rather than left to the wrap, so the emphasis lands on
                "constraint" on its own line at every width.
            *@
            <h1 class="hero__headline">
                <span class="line"><span>I remove the</span></span>
                <span class="line"><span class="hero__accent">constraint</span></span>
                <span class="line"><span>that froze</span></span>
                <span class="line"><span>the estate.</span></span>
            </h1>

            <p class="hero__pitch">
                Senior .NET engineer for the systems everyone else stopped touching. I make
                the architectural call, rebuild what's frozen, and leave behind the template
                and rules that let the next team repeat it.
            </p>

            @*
                One line, not a band of cards. The figures are the skim, and they carry
                their final values in the markup — if the script never runs the correct
                numbers are already on screen, so the count-up can only ever be an
                enhancement, never the difference between a number and a zero. The
                separators are drawn by CSS on the fact they FOLLOW, so a wrap between
                facts never strands a leading middot on the next line. A div, not a p:
                paragraphs are not exposed to accessible naming, and this group needs
                its label to reach a screen reader.

                Each count-up is split in two: the animated number is aria-hidden
                decoration, and a visually-hidden twin carries the final value — what a
                screen reader reads is the settled figure, never whatever the counter
                is mid-flight.
            *@
            <div class="hero__facts" role="group" aria-label="Track record at a glance">
                <span class="hero__fact">upgrade cycle <strong class="mono"><span data-count-to="@UpgradeCycleDays" aria-hidden="true">@UpgradeCycleDays</span><span class="visually-hidden">@UpgradeCycleDays</span></strong> days max, from 5–7</span>
                <span class="hero__fact"><strong class="mono"><span data-count-to="@PaymentMarkets" aria-hidden="true">@PaymentMarkets</span><span class="visually-hidden">@PaymentMarkets</span></strong> payment markets</span>
                <span class="hero__fact">@ExperiencePhrase</span>
                <span class="hero__fact">@Profile.Location — @Profile.Timezone</span>
                <span class="hero__fact hero__fact--gold"><strong class="mono"><span data-count-to="@AwardCount" aria-hidden="true">@AwardCount</span><span class="visually-hidden">@AwardCount</span></strong> company awards</span>
            </div>

            <div class="hero__actions">
                <a class="btn btn--primary" href="/cv">Read the CV</a>
                @*
                    The PDF itself, one tap from the hero: the person this button exists
                    for is the screener who wants the file without reading a page first.
                    target is load-bearing (see Home.razor's download link) — an anchor
                    carrying target is left to the browser instead of Blazor's router,
                    which matches no PDF route.
                *@
                <a class="btn btn--ghost" href="/Bahaa-Aldeen-Mohamed-CV.pdf"
                   target="_blank" rel="noopener" download>Download CV (PDF)</a>
                @if (!string.IsNullOrWhiteSpace(Profile.GitHub))
                {
                    <a class="btn btn--ghost" href="@Profile.GitHub">GitHub</a>
                }
            </div>
        </div>

        <figure class="diagram">
            <figcaption class="mono diagram__label">The decision, in one diagram</figcaption>

            @*
                The diagram's meaning cannot live in its pixels for everyone: this text
                alternative carries the argument — including the blocker, whose point is
                otherwise made only by colour and a dashed border — to screen readers
                and to any visitor the animation never reaches.
            *@
            <p class="visually-hidden">
                Before: three legacy services — .NET Framework 4.5, .NET Core 2.2, and one
                unversioned service — all depend on a Distributed Transaction Coordinator,
                the component pinning them to runtimes that stopped receiving support.
                After: an explicit orchestrator coordinates the same services, modernized,
                with the coordinator removed entirely. The transformation is repeatable:
                a template, rules, and an AI-guided workflow let other teams run it too.
            </p>

            <div class="diagram__body">
                <div class="panel panel--before">
                    <p class="mono panel__label">Before</p>
                    <div class="panel__stack">
                        <span class="node">Service · .NET FW 4.5</span>
                        <span class="node">Service · Core 2.2</span>
                        <span class="node">Service</span>
                        <span class="arrow" aria-hidden="true">↓</span>
                        <span class="node node--blocker">Distributed Transaction Coordinator</span>
                    </div>
                </div>

                <div class="bridge" aria-hidden="true">
                    <span class="bridge__line"></span>
                    <span class="bridge__arrow">→</span>
                </div>

                <div class="panel panel--after">
                    <p class="mono panel__label">After</p>
                    <div class="panel__stack">
                        <span class="node node--lead">Orchestrator</span>
                        <span class="arrow" aria-hidden="true">↓</span>
                        <span class="node">Service · modernized</span>
                        <span class="node">Service · modernized</span>
                        <span class="node">Service</span>
                    </div>
                </div>
            </div>
        </figure>
    </div>
</section>

@code {
    [Parameter, EditorRequired]
    public required Profile Profile { get; set; }

    [Parameter, EditorRequired]
    public required string ExperiencePhrase { get; set; }

    [Parameter]
    public int AwardCount { get; set; }

    [Parameter, EditorRequired]
    public required IReadOnlyList<CaseStudy> CaseStudies { get; set; }

    /// <summary>
    /// The two hero figures are read out of the case-study record, not written into
    /// this markup — the hero used to hardcode "3" and "9", which let it drift from
    /// the very studies the numbers come from. The featured study's outcome carries
    /// the cycle time ("…to a maximum of 3"); the payment study's summary names its
    /// markets ("…across 9 countries"). A missing figure renders 0 in the count-up
    /// target but the fact keeps its words — and the visual-hidden twin still reads
    /// the true sentence, so no wrong number is ever asserted.
    /// </summary>
    private int UpgradeCycleDays => ExtractNumber(FindOutcome("5-7 working days"), "maximum of");

    private int PaymentMarkets => ExtractNumber(FindSummary("9 countries"), "across");

    private string? FindOutcome(string contains) => CaseStudies
        .SelectMany(s => s.Outcomes)
        .FirstOrDefault(o => o.Contains(contains, StringComparison.OrdinalIgnoreCase));

    private string? FindSummary(string contains) => CaseStudies
        .FirstOrDefault(s => s.Summary.Contains(contains, StringComparison.OrdinalIgnoreCase))
        ?.Summary;

    /// <summary>
    /// The number that follows the given anchor phrase — "a maximum of 3", "9 countries"
    /// — not the leading digits, which these sentences do not start with.
    /// </summary>
    private static int ExtractNumber(string? text, string anchor)
    {
        if (string.IsNullOrEmpty(text))
        {
            return 0;
        }

        var anchorIndex = text.IndexOf(anchor, StringComparison.OrdinalIgnoreCase);

        if (anchorIndex < 0)
        {
            return 0;
        }

        var digits = new string(text[(anchorIndex + anchor.Length)..]
            .TakeWhile(c => char.IsDigit(c) || char.IsWhiteSpace(c))
            .ToArray())
            .Trim();

        return int.TryParse(digits, out var value) ? value : 0;
    }
}
