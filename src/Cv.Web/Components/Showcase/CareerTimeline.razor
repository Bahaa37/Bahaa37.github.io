@*
    The career, in order, as the kit's rail: the neutral 1px rule runs down every
    role; only the current one carries the kit's lit mint segment (growing on
    reveal), its live dot and the "Current" marker — mint is the colour of state,
    and the only state on this rail is "now". Eras are not colour-coded: sky, gold
    and violet belong to flows, awards and their own semantics, and a coloured
    side stripe is banned outright.

    A repeat employer appears twice with another company between — being re-hired is
    worth showing plainly rather than smoothing over, so returns are marked.
*@

<section class="section" id="timeline">
    <div class="hl-container section__frame">
        @*
            A plain heading: "3.5+ years" was the weakest fact on the page and it was
            set as a section title. It stays, as context, in the lede.
        *@
        <header class="section__head" data-hl-reveal>
            <h2 class="hl-h2">Experience</h2>
            <p class="hl-lead">
                @ExperiencePhrase across @Employers.Count employers. Each role's stack line
                names only what that role's own record mentions, and numbers appear only
                where they are real.
            </p>
        </header>

        <ol class="timeline">
            @foreach (var role in Roles)
            {
                <li class="hl-rail entry @(role.Period.IsOngoing ? "entry--current" : null)" data-hl-reveal>
                    @* The one thing still in progress: the current role keeps the lit
                       segment and its moving dot. Past roles ride the plain rule. *@
                    @if (role.Period.IsOngoing)
                    {
                        <span class="hl-dot entry__live" aria-hidden="true"></span>
                        <span class="hl-rail__bar" aria-hidden="true"></span>
                    }
                    <div class="entry__body">
                        <h3 class="hl-h4 entry__role">@role.Role</h3>
                        <p class="entry__company">
                            @role.Company@(role.Location is null ? "" : $" · {role.Location}")
                        </p>
                        @* The dates read as data beside the employer, not as a mint
                           eyebrow above the title — the rail's one mint word is the
                           current role's marker. *@
                        <p class="entry__dates">
                            <span>@role.Period.ToShortDisplayString()</span>
                            @if (role.Period.IsOngoing)
                            {
                                <span class="badge badge--now">Current</span>
                            }
                            @if (IsReturn(role))
                            {
                                <span class="badge badge--return">Returned</span>
                            }
                        </p>
                        @{
                            // The per-role stack, derived from this role's own highlight
                            // record against the grouped vocabulary (see ForRole). Real
                            // senior profiles tag the stack on every role; the derivation
                            // keeps the line honest — only what the bullets themselves
                            // name can appear here.
                            var stack = SkillEvidence.ForRole(role, SkillGroups);
                        }
                        @if (stack.Count > 0)
                        {
                            <p class="entry__stack">Stack — @string.Join(" · ", stack.Take(StackLineLimit))</p>
                        }
                        <ul class="entry__points">
                            @foreach (var highlight in role.Highlights.Take(PrimaryHighlightCount))
                            {
                                <li>
                                    @highlight.Text
                                    @if (highlight.HasMetric)
                                    {
                                        <span class="metric-chip">@highlight.Metric</span>
                                    }
                                </li>
                            }
                        </ul>

                        @*
                            The skim is the product: three achievements per role at first
                            paint, the long tail one no-JS disclosure away. A details
                            element works with the runtime disabled, so the static layer
                            keeps every word reachable.
                        *@
                        @if (role.Highlights.Count > PrimaryHighlightCount)
                        {
                            var rest = role.Highlights.Skip(PrimaryHighlightCount).ToList();
                            <details class="disclosure">
                                <summary class="hl-btn hl-btn--ghost hl-btn--sm">Show @rest.Count more for this role</summary>
                                <ul class="entry__points entry__points--more">
                                    @foreach (var highlight in rest)
                                    {
                                        <li>
                                            @highlight.Text
                                            @if (highlight.HasMetric)
                                            {
                                                <span class="metric-chip">@highlight.Metric</span>
                                            }
                                        </li>
                                    }
                                </ul>
                            </details>
                        }
                    </div>
                </li>
            }
        </ol>
    </div>
</section>

@code {
    [Parameter, EditorRequired]
    public required IReadOnlyList<ExperienceEntry> Roles { get; set; }

    [Parameter, EditorRequired]
    public required string ExperiencePhrase { get; set; }

    [Parameter, EditorRequired]
    public required IReadOnlyList<string> Employers { get; set; }

    [Parameter, EditorRequired]
    public required IReadOnlyList<SkillGroup> SkillGroups { get; set; }

    /// <summary>
    /// Highlights shown at first paint per role; the rest sit behind a disclosure.
    /// Three is the skim budget — the strongest achievements lead, and the cv.json
    /// order already ranks them.
    /// </summary>
    private const int PrimaryHighlightCount = 3;

    /// <summary>
    /// The stack line is a byline, not a second skills section: six names is where a
    /// skimmable line stops being one. The full vocabulary lives in the skills sheet.
    /// </summary>
    private const int StackLineLimit = 6;

    /// <summary>
    /// True when an earlier role at the same employer exists further down the list —
    /// that is, this entry is a return rather than a first stint.
    /// </summary>
    private bool IsReturn(ExperienceEntry role)
    {
        var index = Roles.ToList().IndexOf(role);

        return index >= 0 && Roles.Skip(index + 1).Any(r => r.IsSameEmployerAs(role));
    }
}
