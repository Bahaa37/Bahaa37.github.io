@page "/work/{Slug}"
@inject CvDataService CvData
@inject NavigationManager Navigation

@*
    One case study, on a page of its own.

    Four of the five case studies previously had nowhere to go: they were cards on the
    showcase page and that was the end of the thread. A reader who found the DTC removal
    interesting — which is the single most persuasive piece of work here — had no way to
    go deeper, and a search engine had nothing to index for it.

    The content comes from cv.json, so adding a case study adds its page, its sitemap
    entry and its llms.txt line with no new code. The route is parameterized, but
    /work/windoor-wizard-builder stays with WwbWriteup.razor: Blazor matches a literal
    segment ahead of a parameter, so the hand-written long form wins where it exists.
*@

<PageTitle>@(study?.DisplayTitle ?? "Case study") — Bahaa Aldeen Mohamed</PageTitle>

@if (document is null)
{
    <p class="booting">Loading…</p>
}
else if (study is null)
{
    <section class="sheet">
        <div class="shell">
            <h1 class="sheet__title">No such case study</h1>
            <p class="sheet__lede">
                Nothing here matches "@Slug".
                <a href="/#work">See the selected work</a> instead.
            </p>
        </div>
    </section>
}
else
{
    <article class="study">
        <div class="shell study__shell">

            <nav class="crumbs" aria-label="Breadcrumb">
                <a href="/">Home</a>
                <span aria-hidden="true">/</span>
                <a href="/#work">Selected work</a>
            </nav>

            @*
                The h1 sits at the kit's h2 scale: a document title, one step under
                the home page's display headline. The title itself is data (cv.json),
                so it stays one colour — the two-tone split is for hand-written
                headings, where the words can be chosen around the break.
            *@
            <header class="study__head">
                <h1 class="hl-h2 study__title">@study.Title</h1>
                @*
                    Attribution reads as a byline under the title, never as a label
                    above it — same rule as the panels on the home page. Mono: the
                    organisation is metadata, not prose.
                *@
                <p class="study__org mono">@(study.Organisation ?? "Personal project")</p>
                <p class="hl-lead study__summary">@study.Summary</p>

                @* Stack chips are data, not controls — mono, no hover life. *@
                @if (study.Stack.Count > 0)
                {
                    <ul class="stack">
                        @foreach (var item in study.Stack)
                        {
                            <li class="tag">@item</li>
                        }
                    </ul>
                }
            </header>

            @*
                The argument in one before/after, the same treatment as the featured
                card on Home: the problem on the coral side, the outcomes on the mint
                side. A reader who stops here still leaves with the result; the prose
                below is for the reader who wants how.
            *@
            <div class="hl-compare study__compare">
                <div class="hl-compare__from">
                    <h2 class="hl-h4"><span class="hl-dim">The</span> problem</h2>
                    @foreach (var paragraph in Paragraphs(study.Problem))
                    {
                        <p class="hl-body">@paragraph</p>
                    }
                </div>
                @if (study.Outcomes.Count > 0)
                {
                    <div class="hl-compare__to">
                        <h2 class="hl-h4">Outcome</h2>
                        <ul class="outcomes">
                            @foreach (var outcome in study.Outcomes)
                            {
                                <li>@outcome</li>
                            }
                        </ul>
                    </div>
                }
            </div>

            <section class="study__block">
                <h2 class="study__heading"><span class="hl-dim">What I</span> did</h2>
                @foreach (var paragraph in Paragraphs(study.Approach))
                {
                    <p class="hl-body">@paragraph</p>
                }
            </section>

            @*
                Third-party pages a reader can open to check the work is real. They prove
                the system is live and who delivered it — not which part was mine, which
                is why the note says so plainly instead of letting the links imply more.
                The links are ruled cells — the same row grammar as the work index — so
                corroboration reads as part of the record rather than a link dump.
            *@
            @if (study.Evidence.Count > 0)
            {
                <section class="study__block">
                    <h2 class="study__heading"><span class="hl-dim">Check it</span> yourself</h2>
                    <p class="evidence__note">
                        Public pages this site does not control. They show the system is live
                        and who delivered it; the account above is what I did inside it.
                    </p>
                    <ul class="hl-grid study__evidence">
                        @foreach (var link in study.Evidence)
                        {
                            <li class="hl-cell evidence-cell">
                                <a class="evidence-cell__link" href="@link.Url" target="_blank" rel="noopener">
                                    <span>@link.Label</span>
                                    <span class="evidence-cell__arrow" aria-hidden="true">
                                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6"
                                             stroke-linecap="round" stroke-linejoin="round">
                                            <path d="M7 17 17 7" />
                                            <path d="M8 7h9v9" />
                                        </svg>
                                    </span>
                                </a>
                            </li>
                        }
                    </ul>
                </section>
            }

            @if (study.HasDiagram)
            {
                <section class="study__block">
                    <h2 class="study__heading">Architecture</h2>
                    @*
                        The diagram rides in a console window titled by its source file —
                        the Mermaid text is the artefact; the picture is its rendering.
                    *@
                    <div class="hl-window study__diagram">
                        <div class="hl-window__bar">
                            <div class="hl-window__dots"><i></i><i></i><i></i></div>
                            <span class="hl-window__title">architecture.mmd</span>
                        </div>
                        <div class="study__diagram-body">
                            <ArchitectureDiagram Id="@($"study-{study.Slug}")" Source="@study.MermaidDiagram" />
                        </div>
                    </div>
                </section>
            }

            @if (study.HasWriteup)
            {
                <p class="study__writeup">
                    <a class="hl-btn hl-btn--primary hl-btn--sm" href="@study.WriteupUrl">Read the full technical write-up</a>
                </p>
            }

            @*
                Previous and next rather than a bare "back": someone who read one case
                study to the end is the reader most likely to read a second, and asking
                them to return to the index to find it loses most of them.
            *@
            <nav class="study__nav" aria-label="Other case studies">
                @if (previous is not null)
                {
                    <a class="hl-card study__link" href="@($"/work/{previous.Slug}")">
                        <span class="study__link-label">Previous</span>
                        <span class="study__link-title">@previous.Title</span>
                    </a>
                }
                @if (next is not null)
                {
                    <a class="hl-card study__link study__link--next" href="@($"/work/{next.Slug}")">
                        <span class="study__link-label">Next</span>
                        <span class="study__link-title">@next.Title</span>
                    </a>
                }
            </nav>
        </div>
    </article>
}

@code {
    [Parameter]
    public string? Slug { get; set; }

    private CvDocument? document;
    private CaseStudy? study;
    private CaseStudy? previous;
    private CaseStudy? next;

    protected override async Task OnInitializedAsync()
    {
        document = await CvData.GetAsync();
        Select();
    }

    // Navigating between two /work/{slug} routes reuses this component instance rather
    // than creating a new one, so the parameter change has to be picked up here as well
    // — otherwise the previous/next links would render the study you just left.
    protected override void OnParametersSet() => Select();

    /// <summary>
    /// Long prose in cv.json marks its paragraph breaks with a blank line; a single
    /// 250-word block on a case page reads as a wall, not as reasoning.
    /// </summary>
    private static IEnumerable<string> Paragraphs(string text) => text
        .Split("\n\n", StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries);

    private void Select()
    {
        if (document is null)
        {
            return;
        }

        var ordered = document.CaseStudies.OrderBy(c => c.DisplayOrder).ToList();
        var index = ordered.FindIndex(c => string.Equals(c.Slug, Slug, StringComparison.OrdinalIgnoreCase));

        study = index >= 0 ? ordered[index] : null;
        previous = index > 0 ? ordered[index - 1] : null;
        next = index >= 0 && index < ordered.Count - 1 ? ordered[index + 1] : null;
    }
}
