@page "/"
@using Cv.Web.Components.Showcase
@inject CvDataService CvData

<PageTitle>@(document?.Profile.Name ?? "Portfolio") — @(document?.Profile.Title ?? "Software Engineer")</PageTitle>

@if (document is null)
{
    <div class="shell booting">
        <p>Loading…</p>
    </div>
}
else
{
    <Hero Profile="document.Profile"
          AwardCount="document.Awards.Count"
          CaseStudies="document.CaseStudies" />

    @*
        The fold line: every technology the case studies actually used, as one mono
        marquee between hairlines. Distinct, in first-seen order over the studies in
        display order — the union is the data's, so a stack edit re-renders it. The
        kit clones the row for the loop and pauses it on hover or reduced motion;
        without JS it is a plain (clipped, masked) row.
    *@
    <div class="hl-marquee tech-marquee" data-hl-marquee data-hl-speed="40"
         aria-label="Technologies used across the case studies">
        <ul class="hl-marquee__track">
            @foreach (var technology in techUnion)
            {
                <li class="tech-marquee__item">@technology</li>
            }
        </ul>
    </div>

    @*
        The summary paragraph that used to sit here repeated the hero pitch almost word
        for word, one screen apart. It still feeds the meta description, llms.txt and
        the printed CV; on this page the hero carries it.
    *@
    @*
        Proof of work sits above the career detail. On the benchmarked real profiles
        of senior .NET engineers, projects-above-experience is the senior ordering
        for a case-study portfolio: the featured study is the argument, the timeline
        is the evidence trail behind it.

        From here to the contact section every section's container is one ruled
        blueprint column (see .section__frame in app.css): side hairlines at the
        container width, a hairline between sections, the way the reference frames
        its content — not cards on a ground.
    *@
    <section class="section" id="work">
        <div class="hl-container section__frame">
            @*
                One featured case, index rows. Five equal panels made the signature
                DTC re-architecture — the site's whole argument — carry the same weight
                as a routine rebuild, and a 5-way equal choice is a skim-killer. The
                first case by display order gets the full panel; the rest are one skim
                each, and every row opens a page with the real depth.
            *@
            @{
                var orderedStudies = document.CaseStudies.OrderBy(c => c.DisplayOrder).ToList();
                var featuredStudy = orderedStudies.FirstOrDefault();
                var indexStudies = orderedStudies.Skip(1).ToList();
            }
            <header class="section__head" data-hl-reveal>
                <h2 class="hl-h2"><span class="hl-dim">Selected work,</span> in depth</h2>
                @* The count is the data's, so adding a study never leaves this line stale. *@
                <p class="hl-lead">
                    @orderedStudies.Count engagements, told as the decisions behind them — the
                    flagship in full, the rest one line each, every row opening its own page.
                </p>
            </header>

            @if (featuredStudy is not null)
            {
                <CaseStudyPanel Study="featuredStudy" Index="1" />
            }

            <ol class="hl-grid hl-grid--flush case-index" data-hl-reveal="list">
                @foreach (var study in indexStudies)
                {
                    <li class="hl-cell case-row">
                        @* The whole row is the link; the hover (row wash + the arrow's
                           nudge) is on the cell, so it fires anywhere on the row. *@
                        <a class="case-row__link" href="/work/@study.Slug">
                            <div class="case-row__lead">
                                <h3 class="hl-h4 case-row__title">@study.ShortTitle</h3>
                                @* The authored arrow, in the dock icons' stroke language
                                   (24px viewBox, currentColor, 1.6 stroke, round caps). *@
                                <span class="case-row__arrow" aria-hidden="true">
                                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6"
                                         stroke-linecap="round" stroke-linejoin="round">
                                        <path d="M5 12h14" />
                                        <path d="m12 5 7 7-7 7" />
                                    </svg>
                                </span>
                            </div>
                            <div class="case-row__body">
                                <p class="case-row__org">@study.Organisation</p>
                                <p class="hl-body case-row__summary">@study.Summary</p>
                                @if (study.Outcomes.Count > 0)
                                {
                                    <p class="case-row__outcome">@study.Outcomes[0]</p>
                                }
                            </div>
                        </a>
                    </li>
                }
            </ol>
        </div>
    </section>

    @*
        Skills follow the work rather than lead it: the citations beside each skill
        point back at the studies a reader has just seen, so they land as evidence
        instead of as an inventory.
    *@
    <SkillMatrix Groups="document.SkillGroups" Experience="document.Experience" />

    <CareerTimeline Roles="roles" ExperiencePhrase="@experiencePhrase" Employers="employers"
                    SkillGroups="document.SkillGroups" />

    <Credentials Awards="document.Awards"
                 Education="document.Education"
                 Certifications="document.Certifications" />

    @* Third-party words are the strongest social proof a portfolio carries, so they get
       a band of their own — but only when there is something real to show. An empty
       testimonials file renders nothing here, never an invented quote. *@
    @if (testimonials is { Count: > 0 })
    {
        <section class="section" id="testimonials">
            <div class="hl-container section__frame">
                <header class="section__head" data-hl-reveal>
                    <h2 class="hl-h2">What people say</h2>
                    <p class="hl-lead">
                        Recommendations from colleagues and collaborators, each attributed
                        to its author.
                        <a href="/testimonials">Read them all</a>.
                    </p>
                </header>
                <div class="testimonials__grid" data-hl-reveal="list">
                    @foreach (var testimonial in testimonials.OrderBy(t => t.DisplayOrder).Take(3))
                    {
                        <TestimonialCard Testimonial="testimonial" />
                    }
                </div>
            </div>
        </section>
    }

    <section class="section" id="contact">
        <div class="hl-container section__frame">
            <header class="section__head" data-hl-reveal>
                <h2 class="hl-h2"><span class="hl-dim">Open to</span> senior .NET and architecture roles</h2>
                <p class="hl-lead">
                    Email is the quickest way to reach me. The CV carries the same content,
                    formatted for printing and for applicant tracking systems.
                </p>
            </header>
            <div class="contact__actions" data-hl-reveal>
                @*
                    A verb and an icon, not a bare address: a filled pill showing only
                    an email address reads as a label to copy rather than an action to
                    tap. The icon matches the contact dock's envelope so the two read as
                    one system.
                *@
                <a class="hl-btn hl-btn--primary contact__email" href="mailto:@document.Profile.Email">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6"
                         stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                        <rect x="2" y="4" width="20" height="16" rx="2" />
                        <path d="m22 6-10 7L2 6" />
                    </svg>
                    <span class="contact__email-lines">
                        <span>Email me</span>
                        <span class="contact__email-addr">@document.Profile.Email</span>
                    </span>
                </a>
                <a class="hl-btn hl-btn--ghost" href="/cv">Read the CV</a>
                @*
                    LinkedIn sits beside them here rather than in the hero: it is the
                    recruiter's verification channel, and this is the row where a
                    reader who has decided to check arrives.
                *@
                @if (!string.IsNullOrWhiteSpace(document.Profile.LinkedIn))
                {
                    <a class="hl-btn hl-btn--ghost" href="@document.Profile.LinkedIn" target="_blank"
                       rel="noopener">LinkedIn</a>
                }
                @*
                    target is load-bearing, not decoration: Blazor's router claims
                    same-origin anchor clicks and tries to resolve them as routes, and a
                    PDF matches none — so the link did nothing. An anchor carrying a
                    target is left to the browser. Opening in a tab also suits a
                    recruiter, who usually wants to look before saving.
                *@
                <a class="hl-btn hl-btn--ghost" href="/Bahaa-Aldeen-Mohamed-CV.pdf"
                   target="_blank" rel="noopener" download>Download CV (PDF)</a>
            </div>

            @*
                The facts a recruiter asks for in their first reply, as ruled cells.
                Answering them here removes a round trip, and for a remote or
                relocation role it is often the question that decides whether the
                reply comes at all.
            *@
            <dl class="hl-grid hl-grid--flush contact__facts" data-hl-reveal>
                @if (!string.IsNullOrWhiteSpace(document.Profile.Timezone))
                {
                    <div class="hl-cell contact__fact">
                        <dt>Timezone</dt>
                        <dd>
                            @document.Profile.Timezone
                            @if (!string.IsNullOrWhiteSpace(document.Profile.WorkingOverlap))
                            {
                                @* Joined as an explicit string: Razor strips the
                                   whitespace-only seams around expressions, which
                                   is how "(UTC+2)— Full overlap" lost its space. *@
                                <span class="contact__overlap">@($" — {document.Profile.WorkingOverlap}")</span>
                            }
                        </dd>
                    </div>
                }
                @if (!string.IsNullOrWhiteSpace(document.Profile.Availability))
                {
                    <div class="hl-cell contact__fact">
                        <dt>Availability</dt>
                        <dd>@document.Profile.Availability</dd>
                    </div>
                }
                @if (!string.IsNullOrWhiteSpace(document.Profile.Relocation))
                {
                    <div class="hl-cell contact__fact">
                        <dt>Working arrangement</dt>
                        <dd>@document.Profile.Relocation</dd>
                    </div>
                }
                @if (document.Profile.Languages.Count > 0)
                {
                    <div class="hl-cell contact__fact">
                        <dt>Languages</dt>
                        <dd>@string.Join(" · ", document.Profile.Languages)</dd>
                    </div>
                }
            </dl>
        </div>
    </section>
}

@code {
    [Inject]
    private IJSRuntime JS { get; set; } = default!;

    private CvDocument? document;
    private IReadOnlyList<ExperienceEntry> roles = [];
    private IReadOnlyList<string> employers = [];
    private IReadOnlyList<Testimonial> testimonials = [];
    private List<string> techUnion = [];
    private string experiencePhrase = string.Empty;
    private IJSObjectReference? motion;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        // Sections only exist after the document has loaded and rendered, so the observer
        // is armed here rather than on initialization.
        if (document is null)
        {
            return;
        }

        if (motion is null)
        {
            motion = await JS.InvokeAsync<IJSObjectReference>("import", "./js/motion.js");
            await motion.InvokeVoidAsync("start");
        }
        else
        {
            await motion.InvokeVoidAsync("observe");
        }
    }

    protected override async Task OnInitializedAsync()
    {
        document = await CvData.GetAsync();
        testimonials = await CvData.GetTestimonialsAsync();

        // "Now" is read once here rather than inside the render tree, so every derived
        // figure on the page is computed against the same instant.
        var today = YearMonth.FromDateTime(DateTime.Now);

        roles = CareerSummary.InReverseChronologicalOrder(document.Experience);
        employers = CareerSummary.Employers(document.Experience);
        experiencePhrase = CareerSummary.ExperiencePhrase(document.Experience, today);

        // The marquee's union, walked once in the page's own order (display order,
        // first-seen wins) — a LINQ Union would work too, but this reads as what it
        // is: a fold that keeps the studies' ordering.
        foreach (var study in document.CaseStudies.OrderBy(c => c.DisplayOrder))
        {
            foreach (var technology in study.Stack)
            {
                if (!techUnion.Contains(technology))
                {
                    techUnion.Add(technology);
                }
            }
        }
    }
}
